# Seerr Request Approval - Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Encryption key for API key at rest (generate with: openssl rand -hex 32)
SECRET_KEY=

# Seerr instance URL (default: http://localhost:5055)
# Use host.docker.internal when running inside Docker Desktop on Mac/Windows,
# or the Docker host IP when running on a home lab server (e.g., http://172.17.0.1:5055)
SEERR_URL=http://host.docker.internal:5055

# CORS allowed origin (default: http://localhost:5656)
# Must match the port the service is exposed on in docker-compose.yml
ALLOWED_ORIGIN=http://localhost:5656

# Container port (default: 3000)
PORT=3000

# Node environment (default: production)
NODE_ENV=production

# Log level: error, warn, info, http, verbose, debug, silly (default: info)
LOG_LEVEL=info

# Optional: TMDB API key for fallback media details (get at themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional: Custom seerr API base path if Seerr is behind a reverse proxy
# SEERR_API_PATH=/api